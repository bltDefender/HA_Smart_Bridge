HA_URL=ws://homeassistant.local:8123/api/websocket
# Secrets als Docker Secret: secrets/ha_token.txt (nie committen)
HA_TOKEN_FILE=/run/secrets/ha_token
# Streamable-HTTP-Endpunkt des HA-MCP-Servers (Pfad vor Produktivbetrieb in der HA-Doku prüfen)
HA_MCP_URL=http://homeassistant.local:8123/api/mcp
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD_FILE=
QDRANT_URL=http://qdrant:6333
EMBED_MODEL=intfloat/multilingual-e5-small  # "hash" = Dev/Tests ohne Modell
# EMBED_CACHE_DIR=/app/models
STATE_HISTORY_DAYS=14
MCP_SERVER_ENABLED=false  # true: /mcp aktiv, MCP_SERVER_TOKEN(_FILE) Pflicht
MCP_SERVER_TOKEN_FILE=/run/secrets/mcp_server_token
LATITUDE=52.4
LONGITUDE=13.1
TZ=Europe/Berlin
HOLIDAY_COUNTRY=DE
HOLIDAY_SUBDIV=BB
LOG_LEVEL=INFO
APPROVAL_NOTIFY_SERVICE=  # z. B. notify.mobile_app_x; leer = keine HA-Benachrichtigung
BRIDGE_PUBLIC_URL=  # z. B. http://bridge.lan:8080 (Ziel der Freigabe-Buttons)
# APPROVAL_SECRET_FILE=/run/secrets/approval_secret  # leer: data/approval.key wird erzeugt
APPROVAL_TTL_HOURS=24
RULE_SCAN_SECONDS=2
# UI_TOKEN_FILE=/run/secrets/ui_token  # optional: Bearer-Token für /ui/api (leer = nur LAN)
UI_FRAME_ANCESTORS=self  # CSP frame-ancestors für /ui, z. B. self http://homeassistant.local:8123
# UI_DIST_DIR=/app/ui  # Build der Web-UI (Image: gesetzt; lokal: ui/dist)
DRY_RUN=false
EXECUTOR=mcp
