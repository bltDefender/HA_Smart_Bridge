HA_URL=ws://homeassistant.local:8123/api/websocket
# Secrets als Docker Secret: secrets/ha_token.txt (nie committen)
HA_TOKEN_FILE=/run/secrets/ha_token
# Streamable-HTTP-Endpunkt des HA-MCP-Servers (Pfad vor Produktivbetrieb in der HA-Doku prüfen)
HA_MCP_URL=http://homeassistant.local:8123/api/mcp
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD_FILE=
QDRANT_URL=http://qdrant:6333
EMBED_MODEL=intfloat/multilingual-e5-small
MCP_SERVER_ENABLED=false
MCP_SERVER_TOKEN_FILE=/run/secrets/mcp_server_token
LATITUDE=52.4
LONGITUDE=13.1
TZ=Europe/Berlin
HOLIDAY_COUNTRY=DE
HOLIDAY_SUBDIV=BB
LOG_LEVEL=INFO
DRY_RUN=false
EXECUTOR=mcp
