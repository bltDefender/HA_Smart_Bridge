{
  "name": "smart-bridge",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "uv sync && npm install -g @anthropic-ai/claude-code",
  "mounts": [
    "source=${localWorkspaceFolder}/config/policy.yaml,target=${containerWorkspaceFolder}/config/policy.yaml,type=bind,readonly",
    "source=${localWorkspaceFolder}/config/approvals,target=${containerWorkspaceFolder}/config/approvals,type=bind,readonly"
  ]
}
