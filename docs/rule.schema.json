    "Action": {
      "additionalProperties": true,
      "description": "Typ wird in M1 geprüft, Parameter je Typ folgen mit dem Executor (M6).",
      "properties": {
        "type": {
          "enum": [
            "ha_tool",
            "ha_service",
            "mqtt_publish",
            "webhook",
            "notify",
            "delay",
            "wait_for",
            "choose",
            "if"
          ],
          "title": "Type",
          "type": "string"
        },
        "timeout": {
          "anyOf": [
            {
              "pattern": "^-?\\d{1,2}:\\d{2}:\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout"
        },
        "retries": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retries"
        }
      },
      "required": [
        "type"
      ],
      "title": "Action",
      "type": "object"
    },
